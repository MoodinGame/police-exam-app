# Supabase (required)
# Safe to expose in the browser, but keep the server secret private.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-your-supabase-secret-key

# OTP / SMS (required when OTP login is enabled)
THSMS_API_TOKEN=replace-with-your-thsms-api-token
THSMS_SENDER=POLREADY
OTP_HMAC_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Optional: LINE alerts to administrators when a customer submits a payment slip.
# Keep every value server-side only; never prefix these keys with NEXT_PUBLIC_.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_ADMIN_SETUP_TOKEN=replace-with-a-long-random-setup-token
# Local development only: fallback recipients for an outgoing-notification test.
# Leave this empty in Production; production recipients must subscribe through the verified webhook.
LINE_ADMIN_USER_IDS=
# Public, canonical HTTPS URL used in LINE notification links (no trailing slash).
APP_URL=https://your-domain.example

# Local development only. Never set this to true in a deployed environment.
# OTP_DEV_MODE=false

# Optional: reserved for a future browser-side Supabase integration.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

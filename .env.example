# THSMS V2 credentials (server-side only; do not prefix with NEXT_PUBLIC_)
THSMS_API_TOKEN=
THSMS_SENDER=SMS

# Generate a unique random secret for signing OTP challenge/session cookies.
# Example command: openssl rand -base64 32
OTP_HMAC_SECRET=

# Development only. Skips the SMS provider and prints the OTP to the server console,
# so the login flow can be exercised before a sender name is approved.
# Forced off whenever NODE_ENV=production, regardless of this value.
OTP_DEV_MODE=false

# Supabase (Project URL and Publishable key are safe for browser configuration.)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-side only. Never expose this key to the browser or commit a real value.
SUPABASE_SECRET_KEY=
